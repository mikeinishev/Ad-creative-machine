{
    "mcpServers": {
        "figma": {
            "command": "npx",
            "args": [
                "-y",
                "figma-developer-mcp"
            ],
            "env": {
                "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
            }
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@anthropic/mcp-server-playwright"
            ]
        },
        "apify": {
            "command": "npx",
            "args": [
                "-y",
                "@apify/actors-mcp-server"
            ],
            "env": {
                "APIFY_TOKEN": "${APIFY_TOKEN}",
                "APIFY_ACTORS": "curious_coder/facebook-ads-library-scraper,igolaizola/midjourney-automation"
            }
        },
        "everart": {
            "command": "npx",
            "args": [
                "-y",
                "@anthropic/mcp-server-everart"
            ],
            "env": {
                "EVERART_API_KEY": "${EVERART_API_KEY}"
            }
        }
    },
    "defaults": {
        "language": "en",
        "market": "US,CA",
        "max_creatives_per_query": 20,
        "winning_threshold_days": 14
    }
}